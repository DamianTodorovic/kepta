{"art": "setze", "i": 12, "note": "m12", "text": "Model Context Protocol 2026-07-28: stateless core, server/discover, Streamable HTTP Transport, strukturierte Tool-Outputs.", "sek": 0.0}
{"art": "setze", "i": 13, "note": "m13", "text": "nomic-embed-text für lokale Embeddings via Ollama, 1024 Dimensionen, 8k Kontext. Alternative: bge-m3 multilingual.", "sek": 0.0}
