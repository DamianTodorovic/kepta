{
  "appId": "app.kepta.desktop",
  "productName": "KEPTA",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "mac": {
    "icon": "build/icon.icns",
    "category": "public.app-category.productivity",
    "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ]
  },
  "linux": {
    "icon": "build/icon.png",
    "category": "Utility",
    "maintainer": "KEPTA <hello@kepta.app>",
    "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ]
  },
  "win": {
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-win-${arch}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false
  },
  "asar": true,
  "files": [
    "dist/**/*",
    "electron.js",
    "package.json"
  ],
  "copyright": "Copyright © 2026 KEPTA",
  "afterPack": "scripts/adhoc-sign.cjs"
}
