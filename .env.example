# KEPTA-Konfiguration — alle Variablen, die server.ts / src/core wirklich lesen.
# Datei nach Bedarf kopieren: cp .env.example .env

# Port des API-/UI-Servers (default 3000)
PORT=3000

# Bind-Adresse des Servers. Default: 127.0.0.1 (nur localhost) — die API hat keine
# Auth (Memories lesen/löschen, Chat-Proxy). Bindung ans Netz nur bewusst setzen.
KEPTA_HOST=127.0.0.1

# Datenverzeichnis (SQLite-DB, Inbox, Export, Profil). Default: ~/.kepta
KEPTA_DATA_DIR=

# Embedding-Modell für die Hintergrund-Queue (Ollama). Default: nomic-embed-text
KEPTA_EMBED_MODEL=nomic-embed-text

# Ollama-Endpunkt (Core-Embeddings). Default: http://127.0.0.1:11434
KEPTA_OLLAMA_URL=http://127.0.0.1:11434
# Alternativ via Server-Proxy /api/embed (legacy-Variablen, default siehe Code):
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Hinweis: KEPTA braucht KEINE serverseitigen KI-API-Keys. Keys für den Chat
# (OpenAI/Anthropic/…) werden lokal im UI hinterlegt und vom Client direkt
# mitgeschickt; der Server proxied sie nur an den gewählten Provider.

# Intern für Tests (Server nicht automatisch starten) — nicht für den Betrieb:
# KEPTA_NO_AUTOSTART=1
