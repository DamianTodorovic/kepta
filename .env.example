# KEPTA configuration — every variable that server.ts / src/core actually read.
# Copy as needed: cp .env.example .env

# Port of the API/UI server (default 3000)
PORT=3000

# Server bind address. Default: 127.0.0.1 (localhost only) — the API has no
# auth (read/delete memories, chat proxy). Only bind to the network deliberately.
KEPTA_HOST=127.0.0.1

# Data directory (SQLite DB, inbox, export, profile). Default: ~/.kepta
KEPTA_DATA_DIR=

# Embedding model for the background queue (Ollama). Default: nomic-embed-text
KEPTA_EMBED_MODEL=nomic-embed-text

# Ollama endpoint (core embeddings). Default: http://127.0.0.1:11434
KEPTA_OLLAMA_URL=http://127.0.0.1:11434
# Alternative via server proxy /api/embed (legacy variables, defaults in code):
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Write-Gate (F2, opt-in): when exactly "on", memory_save consults the local LLM
# (Ollama /api/chat) before storing a NEW memory — ADD/UPDATE/DELETE/NOOP.
# Without a reachable local LLM it always degrades to ADD (never blocks).
# KEPTA_WRITE_GATE=on
# Chat model used by the gate. Default: llama3.2
# KEPTA_WRITE_GATE_MODEL=llama3.2

# Note: KEPTA does NOT need any server-side AI keys. Chat keys (OpenAI/
# Anthropic/…) are stored locally in the UI and sent directly by the client;
# the server only proxies them to the chosen provider.

# Internal for tests (server does not auto-start) — not for production use:
# KEPTA_NO_AUTOSTART=1
