{
  "name": "kepta",
  "version": "2.11.0",
  "description": "Local-first memory for AI agents \u2014 encrypted SQLite store, hybrid search, MCP server, HTTP API.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && npm run build:mcp && node -e \"require('fs').cpSync('node_modules/pdfjs-dist/cmaps','dist/cmaps',{recursive:true})\"",
    "build:mcp": "esbuild src/mcp-server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/mcp-server.cjs",
    "mcp": "tsx src/mcp-server.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "compression": "^1.8.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.16",
    "ajv": "^8.18.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.3",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "@types/supertest": "^2.0.16",
    "yaml": "^2.6.1"
  },
  "private": true
}
