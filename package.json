{
  "name": "kepta",
  "private": true,
  "version": "3.2.15",
  "description": "K3PTA — Keeps what matters. A local brain for AI agents: SQLite, hybrid retrieval, knowledge graph, MCP 2026-07-28 — no cloud.",
  "author": "Damian Todorovic",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "app": "npm-run-all --parallel dev electron",
    "electron": "wait-on http://localhost:3000 && electron electron.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --external:vite --external:esbuild --external:lightningcss --minify --keep-names --sourcemap --outfile=dist/server.cjs && npm run build:mcp && node -e \"require('fs').cpSync('node_modules/pdfjs-dist/cmaps','dist/cmaps',{recursive:true})\"",
    "build:mcp": "esbuild src/mcp-server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/mcp-server.cjs",
    "screenshots": "npm run build && electron scripts/screenshots.mjs",
    "license-studio": "node tools/license-studio/build.mjs",
    "mcp": "tsx src/mcp-server.ts",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && eslint .",
    "lint:eslint": "eslint .",
    "pretest": "node scripts/pruefe-native.mjs --node && node scripts/pruefe-lock.mjs",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=test-results/vitest.json && node scripts/doku-check.mjs",
    "test:protokoll": "vitest run --reporter=default --reporter=json --outputFile.json=\"test-results/protokoll-$(date -u +%Y-%m-%dT%H-%M-%SZ).json\"",
    "test:cov": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=test-results/vitest.json && node scripts/doku-check.mjs",
    "test:watch": "vitest",
    "eval": "tsx scripts/eval.ts",
    "eval:crypto": "tsx scripts/encryption-eval.ts",
    "build:mac": "npm run build && electron-builder --mac --config electron-builder.json",
    "release:beweisen": "node scripts/release-beweisen.mjs",
    "build:linux": "npm run build && electron-builder --linux --config electron-builder.json",
    "build:win": "npm run build && electron-builder --win --config electron-builder.json",
    "build:npm": "node scripts/build-npm.mjs",
    "metrics": "node scripts/metrics.mjs",
    "ablation": "tsx scripts/ablation.ts",
    "embed:sprachtest": "tsx scripts/embed-sprachtest.ts",
    "app:installieren": "node scripts/install-app.mjs"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "motion": "^13.4.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "npm-run-all": "^4.1.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0",
    "yaml": "^2.9.1"
  },
  "main": "electron.js",
  "productName": "K3PTA",
  "license": "UNLICENSED",
  "homepage": "https://github.com/DamianTodorovic/kepta#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/DamianTodorovic/kepta.git"
  },
  "bugs": {
    "url": "https://github.com/DamianTodorovic/kepta/issues"
  },
  "keywords": [
    "knowledge-base",
    "second-brain",
    "electron",
    "mcp",
    "local-first",
    "privacy",
    "kepta",
    "notizen"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.4.1": true
  }
}
