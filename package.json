{
  "name": "kepta",
  "private": false,
  "version": "2.0.3",
  "description": "KEPTA — Keeps what counts. Das lokale Gehirn für KI-Agenten: SQLite, hybride Suche, Wissensgraph, MCP 2026-07-28 — ohne Cloud.",
  "author": "KEPTA <hello@kepta.app>",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "app": "npm-run-all --parallel dev electron",
    "electron": "wait-on http://localhost:3000 && electron electron.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --external:vite --external:esbuild --external:lightningcss --sourcemap --outfile=dist/server.cjs && npm run build:mcp",
    "build:mcp": "esbuild src/mcp-server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/mcp-server.cjs",
    "mcp": "tsx src/mcp-server.ts",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "eval": "tsx scripts/eval.ts",
    "build:mac": "npm run build && electron-builder --config electron-builder.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "framer-motion": "^13.1.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.37.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "main": "electron.js",
  "productName": "KEPTA",
  "license": "MIT",
  "homepage": "https://github.com/DamianTodorovic/kepta#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/DamianTodorovic/kepta.git"
  },
  "bugs": {
    "url": "https://github.com/DamianTodorovic/kepta/issues"
  },
  "keywords": [
    "knowledge-base",
    "second-brain",
    "electron",
    "mcp",
    "local-first",
    "privacy",
    "kepta",
    "notizen"
  ],
  "engines": {
    "node": ">=22.5"
  }
}
