{
  "appId": "app.kepta.license-studio",
  "productName": "K3PTA License Studio",
  "directories": {
    "app": "tools/license-studio/app",
    "output": "tools/license-studio/release"
  },
  "electronDist": "node_modules/electron/dist",
  "npmRebuild": false,
  "asar": true,
  "files": [
    "main.cjs",
    "preload.cjs",
    "index.html",
    "package.json",
    "!node_modules/**"
  ],
  "mac": {
    "icon": "tools/license-studio/icon.icns",
    "category": "public.app-category.business",
    "target": [
      "dir"
    ]
  },
  "copyright": "Copyright © 2026 Damian Todorovic",
  "afterPack": "scripts/adhoc-sign.cjs",
  "win": {
    "icon": "tools/license-studio/icon.png",
    "target": [
      "portable"
    ]
  }
}
